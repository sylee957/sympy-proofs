module

public import SympyProofs.Calculus.Antiderivative.Program.TrigonometricDescent.Graph
public import SympyProofs.Calculus.Antiderivative.Proof.Solve.Describe
public import SympyProofs.Calculus.Antiderivative.Proof.Elementary.Combinations

/-! The span of the solution columns in the model and the equations describing that span. -/

@[expose] public section

namespace SympyProofs.Calculus.Antiderivative.Trigonometric

variable {R : Type} [CommRing R] [IsDomain R] [DecidableEq R] [NormalizedGCDMonoid R] [Div R]
variable (k : Type) [Field k] [Algebra R k] [FaithfulSMul R k] {n : ℕ}

/-- Interpret the parameter vector and the field element of a solution column. -/
noncomputable def columnValue (m : ℕ) (v : GraphColumn R n) : (Fin m → k) × M k n :=
  (Linear.vector (Model.constantHom k) m v.1, val k v.2)

/-- A list of generators and constraints has precisely the graph generated by its joint
kernel columns over any compatible model field. -/
theorem graphColumns_spec (m : ℕ) (xs : List (K R n)) (rows : List (List (K R 0)))
    (a : Fin m → k) (y : M k n) :
    (a,y) ∈ Submodule.span k (columnValue k m '' {v | v ∈ graphColumns m xs rows}) ↔
      ∃ ds : List k, ds.length = xs.length ∧ y = Model.linearCombination k ds xs ∧
        ∀ r ∈ rows, Model.rowHolds k r (List.ofFn a ++ ds) := by
  rw [← Solve.parameterGraph_iff k m xs rows a y]
  let image (q : List (K R 0)) := (Linear.vector (Model.constantHom k) m q,
    val k (Level.combine (q.drop m) xs))
  let col (q : List (K R 0)) : GraphColumn R n := (q.take m, Level.combine (q.drop m) xs)
  have eq (q : List (K R 0)) : columnValue k m (col q) = image q := by
    dsimp only [columnValue, col, image]
    congr 1
    ext i
    simp [Linear.vector, List.getD_eq_getElem?_getD, i.isLt]
  have seteq : columnValue k m '' {v | v ∈ graphColumns m xs rows} =
      image '' {q | q ∈ Linear.kernel rows (m + xs.length)} := by
    ext z
    constructor
    · rintro ⟨v,hv,rfl⟩
      obtain ⟨q,hq,rfl⟩ := List.mem_map.mp hv
      exact ⟨q,hq,(eq q).symm⟩
    · rintro ⟨q,hq,rfl⟩
      exact ⟨col q, List.mem_map_of_mem (f := col) hq, eq q⟩
  rw [seteq]

/-- The unit rows identify the original parameters with their graph-column linear
combination, while the field outputs form its solution component. -/
theorem describeGraph_spec (m : ℕ) (cols : List (GraphColumn R n)) (p : Fin m → k) (y : M k n) :
    (∃ ds : List k, ds.length = (describeGraph m cols).1.length ∧
      y = Model.linearCombination k ds (describeGraph m cols).1 ∧
      ∀ r ∈ (describeGraph m cols).2, Model.rowHolds k r (List.ofFn p ++ ds)) ↔
      (p,y) ∈ Submodule.span k (columnValue k m '' {v | v ∈ cols}) := by
  rw [Linear.mem_columns_iff]
  simp only [describeGraph, List.length_map, List.forall_mem_map]
  have fst (q : Fin cols.length → k) : (Linear.accumulate cols (columnValue k m) q).1 =
      Linear.accumulate cols (fun v => Linear.vector (Model.constantHom k) m v.1) q := by
    simp [Linear.accumulate_apply, columnValue, Prod.fst_sum]
  have snd (q : Fin cols.length → k) : (Linear.accumulate cols (columnValue k m) q).2 =
      Model.linearCombination k (List.ofFn q) (cols.map Prod.snd) := by
    simp only [Linear.accumulate_apply, Prod.snd_sum, Prod.smul_snd, columnValue,
      Model.smul_eq_C_mul, Solve.linearCombination_ofFn]
  constructor
  · rintro ⟨ds,hd,hy,hr⟩
    let q (i : Fin cols.length) := ds.get (Fin.cast hd.symm i)
    have hq : List.ofFn q = ds := by
      apply List.ext_getElem
      · simpa using hd.symm
      · simp [q]
    refine ⟨q,Prod.ext (fst q |>.trans (funext fun i => ?_)) ((snd q).trans (hq ▸ hy.symm))⟩
    apply (Solve.parameterRow k cols Prod.fst p q i).mp
    rw [hq]
    exact hr i (List.mem_range.mpr i.isLt)
  · rintro ⟨q,h⟩
    refine ⟨List.ofFn q,List.length_ofFn,(congrArg Prod.snd h).symm.trans (snd q),?_⟩
    intro i hi
    let j : Fin m := ⟨i,List.mem_range.mp hi⟩
    apply (Solve.parameterRow k cols Prod.fst p q j).mpr
    exact congrFun ((fst q).symm.trans (congrArg Prod.fst h)) j

end SympyProofs.Calculus.Antiderivative.Trigonometric
