import SympyProofs.JordanKrylov.ChainSpaceIndependence
import SympyProofs.JordanKrylov.RankPartition
import Mathlib.LinearAlgebra.DirectSum.Finite
import Mathlib.Analysis.Complex.Polynomial.Basic
import Mathlib.FieldTheory.Separable

/-! # Jordan chains from a Jordan–Krylov basis

The three assertions of Theorem 14. For an arbitrary power kernel the spectral
component is its intersection with the ambient maximal generalized eigenspace.
-/

namespace SympyProofs.JordanKrylov
open Polynomial Matrix
open scoped DirectSum TensorProduct

/-- The concrete extension of a K-subspace of Kⁿ to a complex subspace of ℂⁿ. -/
noncomputable def complexSpan (K : Subfield ℂ) {n : ℕ}
    (W : Submodule K (Fin n → K)) : Submodule ℂ (Fin n → ℂ) :=
  Submodule.span ℂ (complexVectorMap K n '' (W : Set (Fin n → K)))

theorem complexSpan_iSup (K : Subfield ℂ) {n : ℕ} {ι : Sort*}
    (W : ι → Submodule K (Fin n → K)) :
    complexSpan K (⨆ i, W i) = ⨆ i, complexSpan K (W i) := by
  apply le_antisymm
  · apply Submodule.span_le.mpr
    rintro _ ⟨v, hv, rfl⟩
    let V := (⨆ i, complexSpan K (W i)).restrictScalars K
    have hle : (⨆ i, W i) ≤ V.comap (complexVectorMap K n) := by
      apply iSup_le
      intro i v hv
      exact (le_iSup (fun i => complexSpan K (W i)) i)
        (Submodule.subset_span ⟨v, hv, rfl⟩)
    exact hle hv
  · apply iSup_le
    intro i
    exact Submodule.span_mono (Set.image_mono (le_iSup W i))

/-- Complexification commutes with taking spans. -/
theorem complexSpan_span (K : Subfield ℂ) {n : ℕ} (s : Set (Fin n → K)) :
    complexSpan K (Submodule.span K s) = Submodule.span ℂ (complexVectorMap K n '' s) := by
  apply le_antisymm
  · apply Submodule.span_le.mpr
    rintro _ ⟨v, hv, rfl⟩
    induction hv using Submodule.span_induction with
    | mem v hv => exact Submodule.subset_span ⟨v, hv, rfl⟩
    | zero => simp
    | add x y hx hy ihx ihy =>
      rw [map_add]; exact Submodule.add_mem _ ihx ihy
    | smul a x hx ih =>
      rw [map_smul]
      exact (Submodule.restrictScalars K (Submodule.span ℂ (complexVectorMap K n '' s))).smul_mem a ih
  · exact Submodule.span_mono (Set.image_mono Submodule.subset_span)

/-- Extension from K to ℂ preserves the dimension of a subspace of Kⁿ. -/
theorem finrank_complexSpan (K : Subfield ℂ) {n : ℕ} (W : Submodule K (Fin n → K)) :
    Module.finrank ℂ (complexSpan K W) = Module.finrank K W := by
  classical
  let b := Module.finBasis K W
  have hspan : Submodule.span K (Set.range (fun i => (b i).val)) = W := by
    rw [show Set.range (fun i => (b i).val) = W.subtype '' Set.range b from
      Set.range_comp _ _, Submodule.span_image, b.span_eq, Submodule.map_top,
      Submodule.range_subtype]
  conv_lhs => rw [← hspan, complexSpan_span, ← Set.range_comp]
  have hli : LinearIndependent K (fun i => (b i).val) :=
    b.linearIndependent.map' W.subtype (LinearMap.ker_eq_bot.mpr W.injective_subtype)
  have hC : LinearIndependent ℂ (fun i => complexVectorMap K n (b i).val) :=
    (linearIndependent_algebraMap_comp_iff (R := K) (S := ℂ)).mpr hli
  simpa only [Function.comp_def, Fintype.card_fin] using finrank_span_eq_card hC

/-- Complexifying the kernel of a matrix gives the kernel of the complexified matrix. -/
theorem complexSpan_ker_mulVecLin (K : Subfield ℂ) {n : ℕ}
    (M : Matrix (Fin n) (Fin n) K) :
    complexSpan K (LinearMap.ker M.mulVecLin) = LinearMap.ker (M.map K.subtype).mulVecLin := by
  have hle : complexSpan K (LinearMap.ker M.mulVecLin) ≤
      LinearMap.ker (M.map K.subtype).mulVecLin := by
    apply Submodule.span_le.mpr
    rintro _ ⟨v, hv, rfl⟩
    change (M.map K.subtype) *ᵥ complexVectorMap K n v = 0
    have he := funext (RingHom.map_mulVec K.subtype M v)
    change M *ᵥ v = 0 at hv
    change (M.map K.subtype) *ᵥ (fun i => K.subtype (v i)) = (fun _ => 0)
    simpa only [hv, Function.comp_def, Pi.zero_apply, map_zero] using he.symm
  have hrange : complexSpan K (LinearMap.range M.mulVecLin) =
      LinearMap.range (M.map K.subtype).mulVecLin := by
    rw [Matrix.range_mulVecLin, Matrix.range_mulVecLin, complexSpan_span, ← Set.range_comp]
    rfl
  have hr := finrank_complexSpan K (LinearMap.range M.mulVecLin)
  rw [hrange] at hr
  have hK := LinearMap.finrank_range_add_finrank_ker M.mulVecLin
  have hC := LinearMap.finrank_range_add_finrank_ker (M.map K.subtype).mulVecLin
  simp only [Module.finrank_pi, Fintype.card_fin] at hK hC
  apply Submodule.eq_of_le_of_finrank_le hle
  rw [finrank_complexSpan]
  omega

/-- Complexification of a Krylov generating set is generated by the complexified
Krylov spaces. -/
theorem IsKrylovGeneratingSet.complexSpan_eq (K : Subfield ℂ) {n : ℕ}
    (A : Matrix (Fin n) (Fin n) K) (W : Submodule K (Fin n → K))
    (B : Set (Fin n → K)) (hB : IsKrylovGeneratingSet K A W B) :
    complexSpan K W = ⨆ b : B, complexKrylovSpace K A b.val := by
  have h : W = ⨆ b : B, krylovSpace K A b.val := by
    rw [iSup_subtype]
    exact hB
  rw [h, complexSpan_iSup]
  rfl

/-- Theorem 14(1), directness: the chain spaces of rank-ℓ generators are independent. -/
theorem rankSubset_chainSpaces_independent (K : Subfield ℂ) {n ℓ : ℕ}
    (A : Matrix (Fin n) (Fin n) K) (f : K[X])
    (B : Set (Fin n → K)) (hB : IsJordanKrylovIndependent K A B) (α : ℂ) :
    iSupIndep (fun b : rankSubset K A f B ℓ => chainSpace K A f b.val ℓ α) := by
  have hind := chainSpaces_independent_of_jordanKrylovIndependent K A f B hB α
  let inclusion : rankSubset K A f B ℓ → B := fun b => ⟨b.val, b.property.1⟩
  have hinj : Function.Injective inclusion := by
    intro x y h
    apply Subtype.ext
    exact congrArg (fun b : B => b.val) h
  have h := hind.comp hinj
  change iSupIndep (fun b : rankSubset K A f B ℓ =>
    chainSpace K A f b.val (vectorRank K A f b.val) α) at h
  convert h using 1
  funext b
  rw [b.property.2]

/-- The complex span of all displayed chain vectors from the rank-ℓ generators in B. -/
noncomputable def rankChainSpan (K : Subfield ℂ) {n : ℕ}
    (A : Matrix (Fin n) (Fin n) K) (f : K[X])
    (B : Set (Fin n → K)) (ℓ : ℕ) (α : ℂ) : Submodule ℂ (Fin n → ℂ) :=
  Submodule.span ℂ (Set.range (fun (⟨b, j⟩ : rankSubset K A f B ℓ × Fin ℓ) =>
    pChainAt K A f ℓ (ℓ - j.val) α b.val))

/-- Theorem 14(1), spanning: addition identifies the direct sum of the rank-ℓ
chain spaces with the span of all their displayed chain vectors. -/
theorem rankSubset_chainDirectSum_equiv_span (K : Subfield ℂ) {n ℓ : ℕ}
    (A : Matrix (Fin n) (Fin n) K) (f : K[X])
    (B : Set (Fin n → K)) (hB : IsJordanKrylovIndependent K A B) (α : ℂ) :
    Nonempty ((⨁ b : rankSubset K A f B ℓ, chainSpace K A f b.val ℓ α) ≃ₗ[ℂ]
      rankChainSpan K A f B ℓ α) := by
  classical
  have hspan : (⨆ b : rankSubset K A f B ℓ, chainSpace K A f b.val ℓ α) =
      rankChainSpan K A f B ℓ α := by
    unfold rankChainSpan
    apply le_antisymm
    · apply iSup_le
      intro b
      apply Submodule.span_le.mpr
      rintro _ ⟨j, rfl⟩
      exact Submodule.subset_span ⟨(b, j), rfl⟩
    · apply Submodule.span_le.mpr
      rintro _ ⟨⟨b, j⟩, rfl⟩
      exact (le_iSup (fun b : rankSubset K A f B ℓ => chainSpace K A f b.val ℓ α) b)
        (Submodule.subset_span ⟨j, rfl⟩)
  exact ⟨(LinearEquiv.ofInjective (DirectSum.coeLinearMap _)
    (rankSubset_chainSpaces_independent K A f B hB α).dfinsupp_lsum_injective).trans
    (LinearEquiv.ofEq _ _ (DirectSum.range_coeLinearMap.trans hspan))⟩

/-- Theorem 14(1), chain property: each rank-ℓ generator gives a Jordan chain
of length ℓ at a root of f. -/
theorem rankSubset_isJordanChain (K : Subfield ℂ) {n ℓbar ℓ : ℕ}
    (A : Matrix (Fin n) (Fin n) K) (f : K[X]) (hf : Irreducible f)
    (B : Set (Fin n → K)) (hB : IsJordanKrylovBasis K A (powerKernel K A f ℓbar) B)
    (hℓ : 1 ≤ ℓ) (α : ℂ) (hα : f.eval₂ K.subtype α = 0) :
    ∀ b : rankSubset K A f B ℓ,
      IsJordanChain (A.map K.subtype).mulVecLin α
        (fun j : Fin ℓ => pChainAt K A f ℓ (ℓ - j.val) α b.val) := by
  intro b
  have hu := hB.1.subset K A _ B b.property.1
  have hu0 : b.val ≠ 0 := by
    intro hz
    have hr := b.property.2
    rw [hz, vectorRank_zero] at hr
    omega
  exact pChainAt_isJordanChain K A f hf b.val hu0 hu b.property.2 α hα

/-- The total chain spans of a Jordan–Krylov basis span the complexified power kernel. -/
theorem iSup_rootChainSpan_eq_complexSpan_powerKernel (K : Subfield ℂ) {n ℓbar : ℕ}
    (A : Matrix (Fin n) (Fin n) K) (f : K[X]) (hf : Irreducible f) (hm : f.Monic)
    (B : Set (Fin n → K)) (hB : IsJordanKrylovBasis K A (powerKernel K A f ℓbar) B)
    (α : Fin f.natDegree → ℂ) (hinj : Function.Injective α)
    (hroot : ∀ i, f.eval₂ K.subtype (α i) = 0) :
    (⨆ b : B, rootChainSpan K A f b.val (vectorRank K A f b.val) α) =
      complexSpan K (powerKernel K A f ℓbar) := by
  rw [hB.1.complexSpan_eq K A _ B]
  congr 1
  funext b
  exact rootChainSpan_eq_complexKrylovSpace K A f hf hm b.val
    (hB.1.subset K A _ B b.property) rfl α hinj hroot

/-- Theorem 14(2) for an arbitrary exponent: the chains give precisely the spectral
component of the complexified power kernel. The second conjunct is directness. -/
theorem basis_chain_spectral_component (K : Subfield ℂ) {n ℓbar : ℕ}
    (A : Matrix (Fin n) (Fin n) K) (f : K[X]) (hf : Irreducible f) (hm : f.Monic)
    (B : Set (Fin n → K)) (hB : IsJordanKrylovBasis K A (powerKernel K A f ℓbar) B)
    (α : Fin f.natDegree → ℂ) (hinj : Function.Injective α)
    (hroot : ∀ i, f.eval₂ K.subtype (α i) = 0) (i : Fin f.natDegree) :
    (⨆ b : B, chainSpace K A f b.val (vectorRank K A f b.val) (α i)) =
      complexSpan K (powerKernel K A f ℓbar) ⊓
        Module.End.maxGenEigenspace (A.map K.subtype).mulVecLin (α i) ∧
    iSupIndep (fun b : B => chainSpace K A f b.val (vectorRank K A f b.val) (α i)) := by
  classical
  refine ⟨?_, chainSpaces_independent_of_jordanKrylovIndependent K A f B hB.2 (α i)⟩
  let C := fun j => ⨆ b : B, chainSpace K A f b.val (vectorRank K A f b.val) (α j)
  let G := fun j => Module.End.maxGenEigenspace (A.map K.subtype).mulVecLin (α j)
  have hCG : ∀ j, C j ≤ G j := fun j => iSup_le fun b =>
    chainSpace_le_maxGenEigenspace K A f b.val (hB.1.subset K A _ B b.property)
      rfl (α j) (hroot j)
  have hind : iSupIndep G :=
    (Module.End.independent_maxGenEigenspace (A.map K.subtype).mulVecLin).comp hinj
  have hdis : Disjoint (G i) (⨆ j, ⨆ (_ : j ≠ i), C j) :=
    (hind i).mono_right (iSup_mono fun j => iSup_mono fun _ => hCG j)
  have hsplit : (⨆ j, C j) = C i ⊔ ⨆ j, ⨆ (_ : j ≠ i), C j := by
    apply le_antisymm
    · apply iSup_le
      intro j
      by_cases h : j = i
      · subst j; exact le_sup_left
      · exact (le_iSup_of_le j (le_iSup (fun _ : j ≠ i => C j) h)).trans le_sup_right
    · exact sup_le (le_iSup C i) (iSup_le fun j => iSup_le fun _ => le_iSup C j)
  have htotal : (⨆ j, C j) = complexSpan K (powerKernel K A f ℓbar) := by
    rw [← iSup_rootChainSpan_eq_complexSpan_powerKernel K A f hf hm B hB α hinj hroot]
    exact iSup_comm
  change C i = _ ⊓ G i
  rw [← htotal, hsplit, sup_inf_assoc_of_le _ (hCG i), hdis.symm.eq_bot, sup_bot_eq]

private theorem map_aeval_complex (K : Subfield ℂ) {n : ℕ}
    (A : Matrix (Fin n) (Fin n) K) (f : K[X]) :
    (aeval A f).map K.subtype = aeval (A.map K.subtype) (f.map K.subtype) := by
  refine map_aeval_eq_aeval_map (φ := K.subtype)
    (ψ := (K.subtype.mapMatrix : Matrix (Fin n) (Fin n) K →+*
      Matrix (Fin n) (Fin n) ℂ)) ?_ f A
  ext x i j
  by_cases h : i = j <;>
    simp [algebraMap, Matrix.scalar, Matrix.diagonal, Matrix.map_apply, h]

private theorem matrix_end_pow_apply {n : ℕ} (M : Matrix (Fin n) (Fin n) ℂ)
    (k : ℕ) (v : Fin n → ℂ) : (M.mulVecLin ^ k) v = M ^ k *ᵥ v := by
  induction k generalizing v with
  | zero => simp
  | succ k ih => simp [pow_succ, Module.End.mul_apply, ih, Matrix.mulVec_mulVec]

/-- A root's entire generalized eigenspace lies in the complexified primary kernel
once the exponent captures ker f(A)^n. In particular, any exponent at least n suffices. -/
theorem maxGenEigenspace_le_complexSpan_powerKernel (K : Subfield ℂ) {n ℓbar : ℕ}
    (A : Matrix (Fin n) (Fin n) K) (f : K[X]) (α : ℂ)
    (hα : f.eval₂ K.subtype α = 0)
    (hfull : powerKernel K A f n ≤ powerKernel K A f ℓbar) :
    Module.End.maxGenEigenspace (A.map K.subtype).mulVecLin α ≤
      complexSpan K (powerKernel K A f ℓbar) := by
  apply le_trans (b := complexSpan K (powerKernel K A f n)) ?_
    (Submodule.span_mono (Set.image_mono hfull))
  rw [powerKernel, complexSpan_ker_mulVecLin, Matrix.map_pow, map_aeval_complex]
  intro v hv
  rw [Module.End.maxGenEigenspace_eq_genEigenspace_finrank] at hv
  simp only [Module.finrank_pi, Fintype.card_fin, Module.End.mem_genEigenspace_nat,
    LinearMap.mem_ker] at hv
  have he : (A.map K.subtype).mulVecLin - α • 1 =
      (A.map K.subtype - α • 1).mulVecLin := by ext x i; simp
  rw [he, matrix_end_pow_apply] at hv
  have hd : X - C α ∣ f.map K.subtype := by
    apply dvd_iff_isRoot.mpr
    simpa only [IsRoot, eval_map] using hα
  obtain ⟨q, hq⟩ := hd
  have hp : (f.map K.subtype) ^ n = q ^ n * (X - C α) ^ n := by
    rw [hq, mul_pow, mul_comm]
  have hp' := congrArg (aeval (A.map K.subtype)) hp
  simp only [map_pow, map_mul, map_sub, aeval_X, aeval_C, Algebra.algebraMap_eq_smul_one] at hp'
  change aeval (A.map K.subtype) (f.map K.subtype) ^ n *ᵥ v = 0
  rw [hp', ← Matrix.mulVec_mulVec, hv, Matrix.mulVec_zero]

/-- Theorem 14(2): addition identifies the direct sum of the chain spaces
with the full generalized eigenspace of A at any root α of f. -/
theorem basis_chainDirectSum_equiv_maxGenEigenspace (K : Subfield ℂ) {n ℓbar : ℕ}
    (A : Matrix (Fin n) (Fin n) K) (f : K[X]) (hf : Irreducible f) (hm : f.Monic)
    (hfull : powerKernel K A f n ≤ powerKernel K A f ℓbar)
    (B : Set (Fin n → K)) (hB : IsJordanKrylovBasis K A (powerKernel K A f ℓbar) B)
    (α : ℂ) (hα : f.eval₂ K.subtype α = 0) :
    Nonempty ((⨁ b : B, chainSpace K A f b.val (vectorRank K A f b.val) α) ≃ₗ[ℂ]
      Module.End.maxGenEigenspace (A.map K.subtype).mulVecLin α) := by
  classical
  have hsep : (f.map K.subtype).Separable := hf.separable.map
  have hcard : (f.map K.subtype).roots.toFinset.card = f.natDegree := by
    rw [Multiset.toFinset_card_of_nodup (nodup_roots hsep),
      ← (IsAlgClosed.splits (f.map K.subtype)).natDegree_eq_card_roots,
      Polynomial.natDegree_map]
  let e := (Finset.equivFinOfCardEq hcard).symm
  let β : Fin f.natDegree → ℂ := fun j => (e j).val
  have hinj : Function.Injective β := Subtype.val_injective.comp e.injective
  have hroot : ∀ j, f.eval₂ K.subtype (β j) = 0 := by
    intro j
    have hj := isRoot_of_mem_roots (Multiset.mem_toFinset.mp (e j).property)
    simpa only [IsRoot, eval_map] using hj
  have hmem : α ∈ (f.map K.subtype).roots.toFinset := by
    apply Multiset.mem_toFinset.mpr
    apply (mem_roots (Polynomial.map_ne_zero hf.ne_zero)).mpr
    simpa only [IsRoot, eval_map] using hα
  let i : Fin f.natDegree := e.symm ⟨α, hmem⟩
  have hi : β i = α := congrArg Subtype.val (e.apply_symm_apply ⟨α, hmem⟩)
  have h := basis_chain_spectral_component K A f hf hm B hB β hinj hroot i
  rw [hi, inf_eq_right.mpr
    (maxGenEigenspace_le_complexSpan_powerKernel K A f α hα hfull)] at h
  exact ⟨(LinearEquiv.ofInjective (DirectSum.coeLinearMap _)
    h.2.dfinsupp_lsum_injective).trans
    (LinearEquiv.ofEq _ _ (DirectSum.range_coeLinearMap.trans h.1))⟩

/-- Theorem 14(3): the direct sum of P_A(b), indexed internally by the roots of f,
is isomorphic to the scalar extension of the primary power kernel. -/
theorem basis_rootChainSpace_tensor_equiv (K : Subfield ℂ) {n ℓbar : ℕ}
    (A : Matrix (Fin n) (Fin n) K) (f : K[X]) (hf : Irreducible f) (hm : f.Monic)
    (B : Set (Fin n → K)) (hB : IsJordanKrylovBasis K A (powerKernel K A f ℓbar) B)
    (hzero : (0 : Fin n → K) ∉ B) :
    Nonempty ((⨁ b : B, rootChainSpace K A f b.val (vectorRank K A f b.val)) ≃ₗ[ℂ]
      (ℂ ⊗[K] powerKernel K A f ℓbar)) := by
  classical
  let : Fintype B := hB.2.1.fintype
  let : ∀ b : B, AddCommGroup (rootChainSpace K A f b.val (vectorRank K A f b.val)) :=
    fun b => inferInstanceAs (AddCommGroup
      (⨁ α : (f.map K.subtype).roots.toFinset,
        chainSpace K A f b.val (vectorRank K A f b.val) α.val))
  let : ∀ b : B, Module.Finite ℂ (rootChainSpace K A f b.val (vectorRank K A f b.val)) :=
    fun b => inferInstanceAs (Module.Finite ℂ
      (⨁ α : (f.map K.subtype).roots.toFinset,
        chainSpace K A f b.val (vectorRank K A f b.val) α.val))
  have hsep : (f.map K.subtype).Separable := hf.separable.map
  have hcard : (f.map K.subtype).roots.toFinset.card = f.natDegree := by
    rw [Multiset.toFinset_card_of_nodup (nodup_roots hsep),
      ← (IsAlgClosed.splits (f.map K.subtype)).natDegree_eq_card_roots,
      Polynomial.natDegree_map]
  have hroot (α : (f.map K.subtype).roots.toFinset) : f.eval₂ K.subtype α.val = 0 := by
    simpa only [IsRoot, eval_map] using
      isRoot_of_mem_roots (Multiset.mem_toFinset.mp α.property)
  obtain ⟨e⟩ := hB.nonempty_directSum_equiv K A _ B
  refine ⟨LinearEquiv.ofFinrankEq (R := ℂ) _ _ ?_⟩
  rw [Module.finrank_baseChange, ← e.finrank_eq, Module.finrank_directSum,
    Module.finrank_directSum]
  apply Finset.sum_congr rfl
  intro b _
  have hu := hB.1.subset K A _ B b.property
  have hu0 : b.val ≠ 0 := fun hz => hzero (hz ▸ b.property)
  rw [finrank_krylovSpace K A f hf hm b.val hu0 hu rfl]
  unfold rootChainSpace
  rw [Module.finrank_directSum]
  simp [finrank_chainSpace K A f hf b.val hu rfl, hroot, hcard, Nat.mul_comm]

end SympyProofs.JordanKrylov
