import SympyProofs.JordanKrylov.KrylovPolynomial
import SympyProofs.JordanKrylov.VectorRank

/-! # The Krylov vector space generated by a vector -/

namespace SympyProofs.JordanKrylov

open Matrix Polynomial

/-- The paper's `L_A(w)`: the K-span of `w, Aw, A²w, …`.
`Submodule K` supplies the vector-space structure and its inclusion in Kⁿ. -/
noncomputable def krylovSpace (K : Subfield ℂ) {n : ℕ}
    (A : Matrix (Fin n) (Fin n) K) (w : Fin n → K) : Submodule K (Fin n → K) :=
  Submodule.span K (Set.range (krylovVector A w))

/-- The displayed definition, with the powers written explicitly. -/
theorem krylovSpace_eq_span (K : Subfield ℂ) {n : ℕ}
    (A : Matrix (Fin n) (Fin n) K) (w : Fin n → K) :
    krylovSpace K A w = Submodule.span K (Set.range (fun k : ℕ => A ^ k *ᵥ w)) := rfl

theorem pow_mulVec_mem_krylovSpace (K : Subfield ℂ) {n : ℕ}
    (A : Matrix (Fin n) (Fin n) K) (w : Fin n → K) (k : ℕ) :
    A ^ k *ᵥ w ∈ krylovSpace K A w :=
  Submodule.subset_span ⟨k, rfl⟩

theorem self_mem_krylovSpace (K : Subfield ℂ) {n : ℕ}
    (A : Matrix (Fin n) (Fin n) K) (w : Fin n → K) :
    w ∈ krylovSpace K A w := by
  simpa using pow_mulVec_mem_krylovSpace K A w 0

/-- The Krylov space is invariant under A. -/
theorem mulVec_mem_krylovSpace (K : Subfield ℂ) {n : ℕ}
    (A : Matrix (Fin n) (Fin n) K) (w v : Fin n → K)
    (hv : v ∈ krylovSpace K A w) : A *ᵥ v ∈ krylovSpace K A w := by
  induction hv using Submodule.span_induction with
  | mem v hv =>
    obtain ⟨k, rfl⟩ := hv
    simpa [krylovVector, Matrix.mulVec_mulVec, ← pow_succ'] using
      pow_mulVec_mem_krylovSpace K A w (k + 1)
  | zero => simp
  | add x y hx hy ihx ihy =>
    simpa only [Matrix.mulVec_add] using (krylovSpace K A w).add_mem ihx ihy
  | smul a x hx ih =>
    simpa only [Matrix.mulVec_smul] using (krylovSpace K A w).smul_mem a ih

/-- It is the smallest A-invariant subspace containing w. -/
theorem krylovSpace_le (K : Subfield ℂ) {n : ℕ}
    (A : Matrix (Fin n) (Fin n) K) (w : Fin n → K)
    (S : Submodule K (Fin n → K)) (hw : w ∈ S)
    (hA : ∀ v ∈ S, A *ᵥ v ∈ S) : krylovSpace K A w ≤ S := by
  apply Submodule.span_le.mpr
  rintro v ⟨k, rfl⟩
  change A ^ k *ᵥ w ∈ S
  induction k with
  | zero => simpa using hw
  | succ k ih =>
    simpa only [Matrix.mulVec_mulVec, ← pow_succ'] using hA (A ^ k *ᵥ w) ih

/-- The finite set `𝓛_{A,d}(u) = {u, Au, …, A^(d-1)u}`.
The index type `Fin d` includes exactly the exponents below d. -/
noncomputable def krylovVectors (K : Subfield ℂ) {n : ℕ}
    (A : Matrix (Fin n) (Fin n) K) (u : Fin n → K) (d : ℕ) : Set (Fin n → K) :=
  Set.range (fun k : Fin d => krylovVector A u k)

theorem mem_krylovVectors (K : Subfield ℂ) {n : ℕ}
    (A : Matrix (Fin n) (Fin n) K) (u v : Fin n → K) (d : ℕ) :
    v ∈ krylovVectors K A u d ↔ ∃ k : ℕ, k < d ∧ A ^ k *ᵥ u = v := by
  constructor
  · rintro ⟨k, hk⟩
    exact ⟨k, k.isLt, hk⟩
  · rintro ⟨k, hk, hv⟩
    exact ⟨⟨k, hk⟩, hv⟩

/-- The truncated Krylov space `L_{A,d}(u) = span_K 𝓛_{A,d}(u)`.
For the displayed definition in the paper, take `d = f.natDegree`. -/
noncomputable def truncatedKrylovSpace (K : Subfield ℂ) {n : ℕ}
    (A : Matrix (Fin n) (Fin n) K) (u : Fin n → K) (d : ℕ) : Submodule K (Fin n → K) :=
  Submodule.span K (krylovVectors K A u d)

theorem truncatedKrylovSpace_eq_span (K : Subfield ℂ) {n : ℕ}
    (A : Matrix (Fin n) (Fin n) K) (u : Fin n → K) (d : ℕ) :
    truncatedKrylovSpace K A u d = Submodule.span K (krylovVectors K A u d) := rfl

theorem truncatedKrylovSpace_le_krylovSpace (K : Subfield ℂ) {n : ℕ}
    (A : Matrix (Fin n) (Fin n) K) (u : Fin n → K) (d : ℕ) :
    truncatedKrylovSpace K A u d ≤ krylovSpace K A u := by
  apply Submodule.span_le.mpr
  rintro v ⟨k, rfl⟩
  exact pow_mulVec_mem_krylovSpace K A u k

/-- A commutes with f(A), and therefore with every power of f(A). -/
theorem commute_aeval_pow (K : Subfield ℂ) {n : ℕ}
    (A : Matrix (Fin n) (Fin n) K) (f : K[X]) (ℓ : ℕ) :
    Commute A ((aeval A f) ^ ℓ) := by
  have hc : Commute A (aeval A f) := by
    simpa using (Commute.all (X : K[X]) f).map (aeval A)
  exact hc.pow_right ℓ

/-- The paper's inclusion holds whenever u ∈ ker f(A)^ℓ; exact rank is unnecessary. -/
theorem krylovSpace_le_powerKernel (K : Subfield ℂ) {n : ℕ}
    (A : Matrix (Fin n) (Fin n) K) (f : K[X]) (u : Fin n → K) (ℓ : ℕ)
    (hu : u ∈ powerKernel K A f ℓ) :
    krylovSpace K A u ≤ powerKernel K A f ℓ := by
  apply krylovSpace_le K A u _ hu
  intro v hv
  rw [mem_powerKernel] at hv ⊢
  rw [Matrix.mulVec_mulVec, ← (commute_aeval_pow K A f ℓ).eq,
    ← Matrix.mulVec_mulVec, hv, Matrix.mulVec_zero]

/-- The same inclusion with the paper's explicit rank hypothesis. -/
theorem krylovSpace_le_powerKernel_of_rank (K : Subfield ℂ) {n : ℕ}
    (A : Matrix (Fin n) (Fin n) K) (f : K[X]) (u : Fin n → K)
    {ℓbar : ℕ} (hu : u ∈ powerKernel K A f ℓbar) {ℓ : ℕ}
    (hrank : vectorRank K A f u = ℓ) :
    krylovSpace K A u ≤ powerKernel K A f ℓ := by
  apply krylovSpace_le_powerKernel
  simpa only [hrank] using mem_powerKernel_vectorRank K A f u hu

theorem truncatedKrylovSpace_le_powerKernel (K : Subfield ℂ) {n : ℕ}
    (A : Matrix (Fin n) (Fin n) K) (f : K[X]) (u : Fin n → K) (d ℓ : ℕ)
    (hu : u ∈ powerKernel K A f ℓ) :
    truncatedKrylovSpace K A u d ≤ powerKernel K A f ℓ :=
  (truncatedKrylovSpace_le_krylovSpace K A u d).trans
    (krylovSpace_le_powerKernel K A f u ℓ hu)

end SympyProofs.JordanKrylov
