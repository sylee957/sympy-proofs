import SympyProofs.JordanKrylov.Algorithms.JordanKrylovBasisAlgorithmLemmas
/-! # Invariants for the Jordan–Krylov basis algorithm

The table invariant records independence and the terminal-column representation.
The work invariant also tracks the space generated by all unprocessed vectors.
-/
namespace SympyProofs.JordanKrylov
open Matrix Polynomial
/-- The accepted generators, independent of their storage layer. -/
def acceptedGenerators {K : Type} {n : ℕ} (basis : ℕ → Finset (Fin n → K)) : Set (Fin n → K) :=
  {v | ∃ j, v ∈ basis j}

/-- The invariant subspace generated by a set of Krylov generators. -/
noncomputable def generatorSpace (K : Subfield ℂ) {n : ℕ} (A : Matrix (Fin n) (Fin n) K)
    (S : Set (Fin n → K)) : Submodule K (Fin n → K) := ⨆ v ∈ S, krylovSpace K A v

/-- The space generated by the unprocessed lower halves in a list. -/
noncomputable def pairedListSpace (K : Subfield ℂ) {n : ℕ} (A : Matrix (Fin n) (Fin n) K)
    (vs : List (PairedColumn K n)) : Submodule K (Fin n → K) :=
  ⨆ v ∈ vs, krylovSpace K A v.bottom

/-- The space generated by all pending layers. -/
noncomputable def pendingSpace (K : Subfield ℂ) {n : ℕ} (A : Matrix (Fin n) (Fin n) K)
    (pending : ℕ → List (PairedColumn K n)) : Submodule K (Fin n → K) :=
  ⨆ j, pairedListSpace K A (pending j)

 theorem generatorSpace_insert (K : Subfield ℂ) {n : ℕ}
    (A : Matrix (Fin n) (Fin n) K) (S : Set (Fin n → K)) (v : Fin n → K) :
    generatorSpace K A (insert v S) = generatorSpace K A S ⊔ krylovSpace K A v := by
  simp [generatorSpace, iSup_or, iSup_sup_eq, sup_comm]

 theorem generatorSpace_stable (K : Subfield ℂ) {n : ℕ}
    (A : Matrix (Fin n) (Fin n) K) (S : Set (Fin n → K)) :
    ∀ x ∈ generatorSpace K A S, A *ᵥ x ∈ generatorSpace K A S := by
  intro x hx
  have hx' : x ∈ ⨆ v : S, krylovSpace K A v.val := by
    simpa only [iSup_subtype, generatorSpace] using hx
  clear hx
  induction hx' using Submodule.iSup_induction' with
  | mem v x hx =>
    have hle : krylovSpace K A v.val ≤ generatorSpace K A S :=
      le_iSup_of_le v.val (le_iSup_of_le v.property le_rfl)
    exact hle (mulVec_mem_krylovSpace K A v.val x hx)
  | zero => simp
  | add x y hx hy ihx ihy => simpa only [Matrix.mulVec_add] using Submodule.add_mem _ ihx ihy

 theorem pairedListSpace_cons (K : Subfield ℂ) {n : ℕ}
    (A : Matrix (Fin n) (Fin n) K) (v : PairedColumn K n) (vs : List (PairedColumn K n)) :
    pairedListSpace K A (v :: vs) = krylovSpace K A v.bottom ⊔ pairedListSpace K A vs := by
  simp [pairedListSpace, List.mem_cons, iSup_or, iSup_sup_eq]

 theorem pairedListSpace_append (K : Subfield ℂ) {n : ℕ}
    (A : Matrix (Fin n) (Fin n) K) (xs ys : List (PairedColumn K n)) :
    pairedListSpace K A (xs ++ ys) = pairedListSpace K A xs ⊔ pairedListSpace K A ys := by
  simp [pairedListSpace, List.mem_append, iSup_or, iSup_sup_eq]

 theorem acceptedGenerators_insert {K : Type} [DecidableEq K] {n : ℕ}
    (basis : ℕ → Finset (Fin n → K)) (j : ℕ) (v : Fin n → K) :
    acceptedGenerators (Function.update basis j (insert v (basis j))) =
      insert v (acceptedGenerators basis) := by
  ext x
  simp only [acceptedGenerators, Set.mem_ofPred_eq, Set.mem_insert_iff]
  constructor
  · rintro ⟨k, hk⟩
    by_cases he : k = j
    · subst k
      simp only [Function.update_self, Finset.mem_insert] at hk
      exact hk.imp_right (fun hx => ⟨j, hx⟩)
    · rw [Function.update_of_ne he] at hk
      exact Or.inr ⟨k, hk⟩
  · rintro (rfl | ⟨k, hk⟩)
    · exact ⟨j, by simp⟩
    · by_cases he : k = j
      · subst k; exact ⟨j, by simp [hk]⟩
      · exact ⟨k, by simpa [pendingSpace, Function.update_of_ne he] using hk⟩
@[simp] theorem pairedListSpace_nil (K : Subfield ℂ) {n : ℕ}
    (A : Matrix (Fin n) (Fin n) K) : pairedListSpace K A [] = ⊥ := by
  simp [pairedListSpace]

@[simp] theorem generatorSpace_empty (K : Subfield ℂ) {n : ℕ}
    (A : Matrix (Fin n) (Fin n) K) : generatorSpace K A ∅ = ⊥ := by
  simp [generatorSpace]

 theorem pendingSpace_extract (K : Subfield ℂ) {n : ℕ}
    (A : Matrix (Fin n) (Fin n) K) (pending : ℕ → List (PairedColumn K n)) (j : ℕ) :
    pendingSpace K A pending = pairedListSpace K A (pending j) ⊔
      pendingSpace K A (Function.update pending j []) := by
  apply le_antisymm
  · apply iSup_le
    intro k
    by_cases he : k = j
    · subst k; exact le_sup_left
    · have hle : pairedListSpace K A (pending k) ≤
          pendingSpace K A (Function.update pending j []) := by
        exact (by simpa [pendingSpace, Function.update_of_ne he] using
          (le_iSup (fun k => pairedListSpace K A (Function.update pending j [] k)) k))
      exact hle.trans le_sup_right
  · apply sup_le (le_iSup _ j)
    apply iSup_le
    intro k
    by_cases he : k = j
    · subst k; simp
    · simpa [pendingSpace, Function.update_of_ne he] using
        (le_iSup (fun k => pairedListSpace K A (pending k)) k)

 theorem pendingSpace_append_one (K : Subfield ℂ) {n : ℕ}
    (A : Matrix (Fin n) (Fin n) K) (pending : ℕ → List (PairedColumn K n))
    (j : ℕ) (v : PairedColumn K n) :
    pendingSpace K A (Function.update pending j (pending j ++ [v])) =
      pendingSpace K A pending ⊔ krylovSpace K A v.bottom := by
  rw [pendingSpace_extract K A _ j, pendingSpace_extract K A pending j]
  simp only [Function.update_self, Function.update_idem, pairedListSpace_append,
    pairedListSpace_cons, pairedListSpace_nil, sup_bot_eq]
  ac_rfl

/-- Mathematical invariant of the reduced table while processing rank ℓ. -/
structure EliminationTableInvariant (K : Subfield ℂ) {n : ℕ}
    (A : Matrix (Fin n) (Fin n) K) (f : K[X]) (ℓbar ℓ : ℕ)
    (B : Set (Fin n → K)) (D : Array (Fin n × PairedColumn K n)) : Prop where
  independent : IsJordanKrylovIndependent K A B
  primary : B ⊆ (powerKernel K A f ℓbar : Set (Fin n → K))
  echelon : PairedEchelon D.toList
  paired : ∀ iw ∈ D.toList, iw.2.top = (aeval A f)^(ℓ - 1) *ᵥ iw.2.bottom
  bounded : ∀ iw ∈ D.toList, iw.2.bottom ∈ powerKernel K A f ℓ
  generated : ∀ iw ∈ D.toList, iw.2.bottom ∈ generatorSpace K A B
  terminal_span : pairedTopSpan D = ⨆ b : B, krylovSpace K A (terminalVector K A f b.val)

theorem EliminationTableInvariant.accept
    (K : Subfield ℂ) [DecidableEq K] {n ℓbar ℓ : ℕ}
    (A : Matrix (Fin n) (Fin n) K) (f : K[X]) (hf : Irreducible f) (hm : f.Monic)
    (B : Set (Fin n → K)) (D : Array (Fin n × PairedColumn K n))
    (h : EliminationTableInvariant K A f ℓbar ℓ B D)
    (hpos : 1 ≤ ℓ) (hle : ℓ ≤ ℓbar)
    (v : PairedColumn K n)
    (hv : v.top = (aeval A f)^(ℓ - 1) *ᵥ v.bottom)
    (hvker : v.bottom ∈ powerKernel K A f ℓ)
    (hne : (reducePairedColumn D v).top ≠ 0) :
    let r := reducePairedColumn D v
    let out := (List.range f.natDegree).foldl
      (fun (s : Array (Fin n × PairedColumn K n) × PairedColumn K n) _ =>
        (insertPairedColumn s.1 s.2, ⟨A *ᵥ s.2.top, A *ᵥ s.2.bottom⟩)) (D, r)
    EliminationTableInvariant K A f ℓbar ℓ (insert r.bottom B) out.1 := by
  dsimp only
  let r := reducePairedColumn D v
  have hr : r.top = (aeval A f)^(ℓ - 1) *ᵥ r.bottom :=
    reducePairedColumn_top_eq ((aeval A f)^(ℓ - 1)).mulVecLin D v h.paired hv
  have hrker : r.bottom ∈ powerKernel K A f ℓ :=
    reducePairedColumn_bottom_mem _ D v h.bounded hvker
  have hrank : vectorRank K A f r.bottom = ℓ :=
    reducePairedColumn_rank_eq K A f hpos D v h.paired hv h.bounded hvker hne
  have hrt : r.top = terminalVector K A f r.bottom := by
    simpa only [terminalVector, hrank] using hr
  have hcomm (x : Fin n → K) :
      ((aeval A f)^(ℓ - 1)).mulVecLin (A *ᵥ x) =
        A *ᵥ ((aeval A f)^(ℓ - 1)).mulVecLin x := by
    simp only [Matrix.mulVecLin_apply, Matrix.mulVec_mulVec]
    rw [(commute_aeval_pow K A f (ℓ - 1)).eq]
  have hstable (x : Fin n → K) (hx : x ∈ powerKernel K A f ℓ) :
      A *ᵥ x ∈ powerKernel K A f ℓ :=
    krylovSpace_le_powerKernel K A f x ℓ hx (mulVec_mem_krylovSpace K A x x
      (self_mem_krylovSpace K A x))
  have hloop := insertKrylovColumns_fold_invariant A ((aeval A f)^(ℓ - 1)).mulVecLin
    (powerKernel K A f ℓ) hcomm hstable D r h.echelon h.paired h.bounded hr hrker
    (List.range f.natDegree)
  have hgen : ∀ iw ∈ D.toList, iw.2.bottom ∈ generatorSpace K A (insert r.bottom B) := by
    intro iw hiw
    rw [generatorSpace_insert]
    exact Submodule.mem_sup_left (h.generated iw hiw)
  have hrgen : r.bottom ∈ generatorSpace K A (insert r.bottom B) := by
    rw [generatorSpace_insert]
    exact Submodule.mem_sup_right (self_mem_krylovSpace K A r.bottom)
  have hloopgen := insertKrylovColumns_fold_invariant A ((aeval A f)^(ℓ - 1)).mulVecLin
    (generatorSpace K A (insert r.bottom B)) hcomm (generatorSpace_stable K A _)
    D r h.echelon h.paired hgen hr hrgen (List.range f.natDegree)
  refine ⟨?_, ?_, hloop.1, hloop.2.1, hloop.2.2.1, hloopgen.2.2.1, ?_⟩
  · exact reducePairedColumn_insert_independent K A f hf hm hpos hle B h.independent
      h.primary D v h.echelon h.terminal_span h.paired hv h.bounded hvker hne
  · intro x hx
    rcases Set.mem_insert_iff.mp hx with rfl | hx
    · exact powerKernel_monotone K A f hle hrker
    · exact h.primary hx
  · have hkill : aeval A f *ᵥ r.top = 0 := by
      rw [hr, Matrix.mulVec_mulVec, ← pow_succ', Nat.sub_add_cancel hpos]
      exact hrker
    rw [(insertKrylovColumns_fold_span K A D r f.natDegree).1,
      truncatedKrylovSpace_eq_of_annihilated K A f hm r.top hkill, hrt, h.terminal_span]
    simp only [iSup_subtype, Set.mem_insert_iff, iSup_or, iSup_sup_eq]
    simp [sup_comm, r]

theorem EliminationTableInvariant.lower
    (K : Subfield ℂ) [PolynomialOperations K] {n ℓbar k : ℕ}
    (hops : PolynomialOperations.IsCorrect (K := K))
    (A : Matrix (Fin n) (Fin n) K) (f : K[X]) (hk : 1 ≤ k)
    (B : Set (Fin n → K)) (D : Array (Fin n × PairedColumn K n))
    (h : EliminationTableInvariant K A f ℓbar (k + 1) B D) :
    EliminationTableInvariant K A f ℓbar k B
      (D.map (fun (i, w) => (i, ⟨w.top, PolynomialOperations.applyMatrix f A w.bottom⟩))) := by
  have hh := lowerPairedTable_invariant K hops A f hk D h.echelon h.paired h.bounded
  refine ⟨h.independent, h.primary, hh.1, hh.2.2.1, hh.2.2.2, ?_, ?_⟩
  · intro iw hiw
    obtain ⟨jw, hjw, rfl⟩ := List.mem_map.mp (by simpa only [Array.toList_map] using hiw)
    dsimp only
    rw [hops.applyMatrix_eq]
    have hgen : jw.2.bottom ∈ ⨆ b : B, krylovSpace K A b.val := by
      simpa only [iSup_subtype, generatorSpace] using h.generated jw hjw
    simpa only [iSup_subtype, generatorSpace] using
      aeval_mulVec_mem_iSup_krylovSpace K A (fun b : B => b.val) jw.2.bottom f hgen
  · exact hh.2.1.trans h.terminal_span

/-- The total space generated by accepted and still-unprocessed vectors. -/
noncomputable def workSpace (K : Subfield ℂ) {n : ℕ}
    (A : Matrix (Fin n) (Fin n) K) (B : Set (Fin n → K))
    (todo : List (PairedColumn K n)) (pending : ℕ → List (PairedColumn K n)) :
    Submodule K (Fin n → K) :=
  generatorSpace K A B ⊔ pairedListSpace K A todo ⊔ pendingSpace K A pending

 theorem EliminationTableInvariant.accept_workSpace
    (K : Subfield ℂ) {n ℓbar ℓ : ℕ}
    (A : Matrix (Fin n) (Fin n) K) (f : K[X])
    (B : Set (Fin n → K)) (D : Array (Fin n × PairedColumn K n))
    (h : EliminationTableInvariant K A f ℓbar ℓ B D)
    (v : PairedColumn K n) (todo : List (PairedColumn K n))
    (pending : ℕ → List (PairedColumn K n)) :
    workSpace K A B (v :: todo) pending =
      workSpace K A (insert (reducePairedColumn D v).bottom B) todo pending := by
  unfold workSpace
  rw [pairedListSpace_cons, ← sup_assoc,
    reducePairedColumn_preserves_generating_space K A _ (generatorSpace_stable K A B)
      D v h.generated, generatorSpace_insert]

 theorem EliminationTableInvariant.requeue_workSpace
    (K : Subfield ℂ) {n ℓbar ℓ : ℕ}
    (A : Matrix (Fin n) (Fin n) K) (f : K[X])
    (B : Set (Fin n → K)) (D : Array (Fin n × PairedColumn K n))
    (h : EliminationTableInvariant K A f ℓbar ℓ B D)
    (v : PairedColumn K n) (todo : List (PairedColumn K n))
    (pending : ℕ → List (PairedColumn K n)) (j : ℕ) (terminal : Fin n → K) :
    workSpace K A B (v :: todo) pending =
      workSpace K A B todo (Function.update pending j
        (pending j ++ [⟨terminal, (reducePairedColumn D v).bottom⟩])) := by
  rw [h.accept_workSpace K A f B D v todo pending]
  unfold workSpace
  rw [generatorSpace_insert, pendingSpace_append_one]
  ac_rfl

 theorem EliminationTableInvariant.discard_workSpace
    (K : Subfield ℂ) {n ℓbar ℓ : ℕ}
    (A : Matrix (Fin n) (Fin n) K) (f : K[X])
    (B : Set (Fin n → K)) (D : Array (Fin n × PairedColumn K n))
    (h : EliminationTableInvariant K A f ℓbar ℓ B D)
    (v : PairedColumn K n) (todo : List (PairedColumn K n))
    (pending : ℕ → List (PairedColumn K n))
    (hz : (reducePairedColumn D v).bottom = 0) :
    workSpace K A B (v :: todo) pending = workSpace K A B todo pending := by
  rw [h.accept_workSpace K A f B D v todo pending]
  simp only [workSpace, generatorSpace_insert, hz, krylovSpace_zero, sup_bot_eq]

/-- A pending column has the kernel bound and upper half required at its layer. -/
def ValidLayerColumn (K : Subfield ℂ) {n : ℕ}
    (A : Matrix (Fin n) (Fin n) K) (f : K[X]) (ℓ : ℕ) (v : PairedColumn K n) : Prop :=
  v.bottom ∈ powerKernel K A f ℓ ∧ v.top = (aeval A f)^(ℓ - 1) *ᵥ v.bottom

/-- Inner-loop invariant, including all vectors still needed to generate the kernel. -/
structure EliminationWorkInvariant (K : Subfield ℂ) {n : ℕ}
    (A : Matrix (Fin n) (Fin n) K) (f : K[X]) (ℓbar ℓ : ℕ)
    (B : Set (Fin n → K)) (D : Array (Fin n × PairedColumn K n))
    (todo : List (PairedColumn K n)) (pending : ℕ → List (PairedColumn K n)) : Prop where
  table : EliminationTableInvariant K A f ℓbar ℓ B D
  current : ∀ v ∈ todo, ValidLayerColumn K A f ℓ v
  queued : ∀ j v, v ∈ pending j → 1 ≤ j ∧ j < ℓ ∧ ValidLayerColumn K A f j v
  spans : powerKernel K A f ℓbar = workSpace K A B todo pending

 theorem EliminationWorkInvariant.accept
    (K : Subfield ℂ) [DecidableEq K] {n ℓbar ℓ : ℕ}
    (A : Matrix (Fin n) (Fin n) K) (f : K[X]) (hf : Irreducible f) (hm : f.Monic)
    (B : Set (Fin n → K)) (D : Array (Fin n × PairedColumn K n))
    (v : PairedColumn K n) (todo : List (PairedColumn K n))
    (pending : ℕ → List (PairedColumn K n))
    (h : EliminationWorkInvariant K A f ℓbar ℓ B D (v :: todo) pending)
    (hpos : 1 ≤ ℓ) (hle : ℓ ≤ ℓbar)
    (hne : (reducePairedColumn D v).top ≠ 0) :
    let r := reducePairedColumn D v
    let out := (List.range f.natDegree).foldl
      (fun (s : Array (Fin n × PairedColumn K n) × PairedColumn K n) _ =>
        (insertPairedColumn s.1 s.2, ⟨A *ᵥ s.2.top, A *ᵥ s.2.bottom⟩)) (D, r)
    EliminationWorkInvariant K A f ℓbar ℓ (insert r.bottom B) out.1 todo pending := by
  have hv := h.current v (List.mem_cons_self ..)
  exact ⟨h.table.accept K A f hf hm B D hpos hle v hv.2 hv.1 hne,
    fun w hw => h.current w (List.mem_cons_of_mem _ hw), h.queued,
    h.spans.trans (h.table.accept_workSpace K A f B D v todo pending)⟩

 theorem EliminationWorkInvariant.requeue
    (K : Subfield ℂ) {n ℓbar ℓ : ℕ}
    (A : Matrix (Fin n) (Fin n) K) (f : K[X])
    (B : Set (Fin n → K)) (D : Array (Fin n × PairedColumn K n))
    (v : PairedColumn K n) (todo : List (PairedColumn K n))
    (pending : ℕ → List (PairedColumn K n))
    (h : EliminationWorkInvariant K A f ℓbar ℓ B D (v :: todo) pending)
    (hz : (reducePairedColumn D v).top = 0)
    (hne : (reducePairedColumn D v).bottom ≠ 0) :
    let r := (reducePairedColumn D v).bottom
    let j := vectorRank K A f r
    EliminationWorkInvariant K A f ℓbar ℓ B D todo
      (Function.update pending j (pending j ++ [⟨terminalVector K A f r, r⟩])) := by
  have hv := h.current v (List.mem_cons_self ..)
  have hker := reducePairedColumn_mem_previous_powerKernel K A f D v h.table.paired hv.2 hz
  have hr := reducePairedColumn_rank_lt K A f D v h.table.paired hv.2 hz hne
  refine ⟨h.table, fun w hw => h.current w (List.mem_cons_of_mem _ hw), ?_, ?_⟩
  · intro j w hw
    by_cases he : j = vectorRank K A f (reducePairedColumn D v).bottom
    · subst j
      simp only [Function.update_self, List.mem_append, List.mem_singleton] at hw
      rcases hw with hw | rfl
      · exact h.queued _ _ hw
      · exact ⟨hr.1, hr.2, mem_powerKernel_vectorRank K A f _ hker, rfl⟩
    · rw [Function.update_of_ne he] at hw
      exact h.queued j w hw
  · exact h.spans.trans (h.table.requeue_workSpace K A f B D v todo pending _ _)

 theorem EliminationWorkInvariant.discard
    (K : Subfield ℂ) {n ℓbar ℓ : ℕ}
    (A : Matrix (Fin n) (Fin n) K) (f : K[X])
    (B : Set (Fin n → K)) (D : Array (Fin n × PairedColumn K n))
    (v : PairedColumn K n) (todo : List (PairedColumn K n))
    (pending : ℕ → List (PairedColumn K n))
    (h : EliminationWorkInvariant K A f ℓbar ℓ B D (v :: todo) pending)
    (hz : (reducePairedColumn D v).bottom = 0) :
    EliminationWorkInvariant K A f ℓbar ℓ B D todo pending :=
  ⟨h.table, fun w hw => h.current w (List.mem_cons_of_mem _ hw), h.queued,
    h.spans.trans (h.table.discard_workSpace K A f B D v todo pending hz)⟩

/-- After a layer is exhausted, lower the table and extract the next queue. -/
theorem EliminationWorkInvariant.next_layer
    (K : Subfield ℂ) [PolynomialOperations K] {n ℓbar k : ℕ}
    (hops : PolynomialOperations.IsCorrect (K := K))
    (A : Matrix (Fin n) (Fin n) K) (f : K[X]) (hk : 1 ≤ k)
    (B : Set (Fin n → K)) (D : Array (Fin n × PairedColumn K n))
    (pending : ℕ → List (PairedColumn K n))
    (h : EliminationWorkInvariant K A f ℓbar (k + 1) B D [] pending) :
    EliminationWorkInvariant K A f ℓbar k B
      (D.map (fun (i, w) => (i, ⟨w.top, PolynomialOperations.applyMatrix f A w.bottom⟩)))
      (pending k) (Function.update pending k []) := by
  refine ⟨h.table.lower K hops A f hk B D, ?_, ?_, ?_⟩
  · intro v hv
    exact (h.queued k v hv).2.2
  · intro j v hv
    by_cases he : j = k
    · subst j; simp at hv
    · rw [Function.update_of_ne he] at hv
      have hh := h.queued j v hv
      exact ⟨hh.1, by omega, hh.2.2⟩
  · have hh := h.spans
    simp only [workSpace, pairedListSpace_nil, sup_bot_eq] at hh
    rw [hh, pendingSpace_extract K A pending k]
    exact (sup_assoc _ _ _).symm

/-- No positive pending rank remains after rank one; generation and independence
then give the required Jordan–Krylov basis. -/
theorem EliminationWorkInvariant.finish
    (K : Subfield ℂ) {n ℓbar : ℕ}
    (A : Matrix (Fin n) (Fin n) K) (f : K[X])
    (B : Set (Fin n → K)) (D : Array (Fin n × PairedColumn K n))
    (pending : ℕ → List (PairedColumn K n))
    (h : EliminationWorkInvariant K A f ℓbar 1 B D [] pending) :
    IsJordanKrylovBasis K A (powerKernel K A f ℓbar) B := by
  have hp (j : ℕ) : pending j = [] := by
    apply List.eq_nil_iff_forall_not_mem.mpr
    intro v hv
    have hh := h.queued j v hv
    omega
  refine ⟨?_, h.table.independent⟩
  have hh := h.spans
  simpa only [workSpace, pairedListSpace_nil, pendingSpace, hp, iSup_bot,
    sup_bot_eq, generatorSpace, IsKrylovGeneratingSet] using hh

end SympyProofs.JordanKrylov
